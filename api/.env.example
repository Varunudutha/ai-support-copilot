NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_support_copilot
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
